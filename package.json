{
	"name": "@surrealdb/tanstack-db",
	"description": "Add Offline / Local First Caching & Syncing to your SurrealDB app with TanstackDB and Loro (CRDTs)",
	"version": "1.0.0-alpha.1",
	"license": "Apache-2.0",
	"files": [
		"dist"
	],
	"module": "./dist/index.mjs",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"surrealdb",
		"tanstackdb",
		"crdts",
		"sync",
		"local-first"
	],
	"author": {
		"name": "SurrealDB",
		"url": "https://surrealdb.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/surrealdb/tanstack-db.git"
	},
	"scripts": {
		"build": "tsup src/index.ts",
		"test": "bun test",
		"test:integration": "SURREAL_RUN_INTEGRATION=true bun test tests/surreal.integration.test.ts"
	},
	"dependencies": {
		"@tanstack/db-sqlite-persistence-core": "^0.4.12",
		"loro-crdt": "^1.14.1"
	},
	"peerDependencies": {
		"@tanstack/db": "^0.15.2",
		"@tanstack/query-core": "^5.107.1",
		"@tanstack/query-db-collection": "~1.4.8",
		"@standard-schema/spec": "^1.1.0",
		"surrealdb": "^2.2.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@standard-schema/spec": "^1.1.0",
		"@tanstack/db": "^0.15.2",
		"@tanstack/query-core": "^5.107.1",
		"@tanstack/query-db-collection": "~1.4.8",
		"@tanstack/react-db": "^0.5.12",
		"@tanstack/react-query": "^5.107.1",
		"@types/bun": "^1.3.14",
		"surrealdb": "^2.2.2",
		"tsup": "^8.5.1"
	}
}
